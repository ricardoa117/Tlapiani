# ============================================================
# TLAPIANI - .gitignore
# ============================================================

# ── Frontend ──────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.env
frontend/.env.local
frontend/.env.*.local

# ── Backend ───────────────────────────────────────────────
backend/node_modules/
backend/.env
backend/.env.local

# ── Archivos de sistema ──────────────────────────────────
.DS_Store
Thumbs.db
*.log
*.swp
*.swo
*~

# ── IDEs ──────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── Temporales ────────────────────────────────────────────
*.tmp
*.bak
.cache/

# ── Datos sensibles ───────────────────────────────────────
*.pem
*.key
*.cert
secrets/

# ── CSV de datos (opcional - comentar si quieres subirlos) ─
# backend/data/*.csv